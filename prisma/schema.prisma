generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  admin
  manager
  cashier
}

enum UserStatus {
  active
  locked
  disabled
}

enum StoreStatus {
  active
  inactive
}

enum AuditAction {
  LOGIN_SUCCESS
  LOGIN_FAILED
  LOGIN_LOCKED
  LOGOUT
  LOGOUT_ALL
  TOKEN_REUSE_DETECTED
  SESSION_REVOKED
  PASSWORD_CHANGED
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET_FAILED
  PASSWORD_RESET
  PROFILE_UPDATED
  CATEGORY_CREATED
  CATEGORY_UPDATED
  CATEGORY_DELETED
  CATEGORY_REORDERED
  UNIT_CREATED
  UNIT_UPDATED
  UNIT_DELETED
}

enum CategoryStatus {
  active
  inactive
}

model Store {
  id        String      @id @default(uuid()) @db.Uuid
  code      String      @unique
  name      String
  status    StoreStatus @default(active)
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")
  users     User[]

  @@map("stores")
}

model User {
  id                String             @id @default(uuid()) @db.Uuid
  username          String             @unique
  phone             String             @unique
  name              String
  role              Role
  storeId           String             @map("store_id") @db.Uuid
  passwordHash      String             @map("password_hash")
  status            UserStatus         @default(active)
  failedLoginCount  Int                @default(0) @map("failed_login_count")
  lockedUntil       DateTime?          @map("locked_until")
  passwordChangedAt DateTime           @default(now()) @map("password_changed_at")
  lastLoginAt       DateTime?          @map("last_login_at")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")
  store             Store              @relation(fields: [storeId], references: [id])
  sessions          Session[]
  resetOtps         PasswordResetOtp[]
  auditLogs         AuditLog[]

  @@index([storeId])
  @@map("users")
}

model Session {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  familyId     String    @map("family_id") @db.Uuid
  tokenHash    String    @unique @map("token_hash")
  userAgent    String?   @map("user_agent")
  ip           String?
  remember     Boolean   @default(false)
  expiresAt    DateTime  @map("expires_at")
  revokedAt    DateTime? @map("revoked_at")
  replacedById String?   @map("replaced_by_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at")
  lastUsedAt   DateTime  @default(now()) @map("last_used_at")
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([familyId])
  @@map("sessions")
}

model PasswordResetOtp {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  codeHash  String    @map("code_hash")
  attempts  Int       @default(0)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt])
  @@map("password_reset_otps")
}

model AuditLog {
  id        String      @id @default(uuid()) @db.Uuid
  userId    String?     @map("user_id") @db.Uuid
  action    AuditAction
  ip        String?
  userAgent String?     @map("user_agent")
  meta      Json?
  createdAt DateTime    @default(now()) @map("created_at")
  user      User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}

model Category {
  id          String         @id @default(uuid()) @db.Uuid
  name        String         @db.VarChar(50)
  nameKey     String         @unique @map("name_key")
  description String?        @db.VarChar(255)
  icon        String         @default("package")
  color       String         @default("slate")
  status      CategoryStatus @default(active)
  sortOrder   Int            @map("sort_order")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")
  products    Product[]

  @@index([sortOrder])
  @@map("categories")
}

model Unit {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @db.VarChar(20)
  nameKey     String    @unique @map("name_key")
  description String?   @db.VarChar(255)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  products    Product[]

  @@map("units")
}

model Product {
  id         String   @id @default(uuid()) @db.Uuid
  name       String   @db.VarChar(200)
  categoryId String   @map("category_id") @db.Uuid
  unitId     String   @map("unit_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  unit       Unit     @relation(fields: [unitId], references: [id], onDelete: Restrict)

  @@index([categoryId])
  @@index([unitId])
  @@map("products")
}
