generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  admin
  manager
  cashier
}

enum UserStatus {
  active
  locked
  disabled
}

enum StoreStatus {
  active
  inactive
}

enum AuditAction {
  LOGIN_SUCCESS
  LOGIN_FAILED
  LOGIN_LOCKED
  LOGOUT
  LOGOUT_ALL
  TOKEN_REUSE_DETECTED
  SESSION_REVOKED
  PASSWORD_CHANGED
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET_FAILED
  PASSWORD_RESET
  PROFILE_UPDATED
  CATEGORY_CREATED
  CATEGORY_UPDATED
  CATEGORY_DELETED
  CATEGORY_REORDERED
  UNIT_CREATED
  UNIT_UPDATED
  UNIT_DELETED
  PRODUCT_CREATED
  PRODUCT_UPDATED
  PRODUCT_STATUS_CHANGED
  PRODUCT_DELETED
  STOCK_ADJUSTED
  IMAGE_UPLOADED
  MIN_STOCK_UPDATED
  SUPPLIER_CREATED
  SUPPLIER_UPDATED
  SUPPLIER_STATUS_CHANGED
  SUPPLIER_DELETED
  SUPPLIER_PAYMENT_CREATED
  STORE_UPDATED
  PURCHASE_ORDER_CREATED
  PURCHASE_ORDER_UPDATED
  PURCHASE_ORDER_PLACED
  PURCHASE_ORDER_CANCELLED
  PURCHASE_RECEIVING_DISCARDED
  GOODS_RECEIVED
  CUSTOMER_CREATED
  CUSTOMER_UPDATED
  CUSTOMER_STATUS_CHANGED
  CUSTOMER_DELETED
  POINTS_ADJUSTED
  MEMBERSHIP_UPDATED
  PROMOTION_CREATED
  PROMOTION_UPDATED
  PROMOTION_STATE_CHANGED
  PROMOTION_DELETED
}

enum PurchaseOrderStatus {
  draft
  ordered
  receiving
  partial
  completed
  cancelled
}

enum SupplierStatus {
  active
  suspended
  inactive
}

enum SupplierLedgerKind {
  receipt
  payment
  return
  adjustment
}

enum PaymentMethod {
  cash
  transfer
}

enum ProductStatus {
  active
  inactive
}

enum ImageFit {
  cover
  contain
  auto
}

enum MovementType {
  initial
  import
  sale
  return
  adjust_in
  adjust_out
}

enum CategoryStatus {
  active
  inactive
}

model Store {
  id        String      @id @default(uuid()) @db.Uuid
  code      String      @unique
  name      String
  address   String?     @db.VarChar(255)
  phone     String?     @db.VarChar(15)
  taxCode   String?     @map("tax_code") @db.VarChar(13)
  receiptFooter String? @map("receipt_footer") @db.VarChar(255)
  status    StoreStatus @default(active)
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")
  users     User[]
  stocks    ProductStock[]
  movements StockMovement[]
  purchaseOrders PurchaseOrder[]
  goodsReceipts  GoodsReceipt[]

  @@map("stores")
}

model User {
  id                String             @id @default(uuid()) @db.Uuid
  username          String             @unique
  phone             String             @unique
  name              String
  role              Role
  storeId           String             @map("store_id") @db.Uuid
  passwordHash      String             @map("password_hash")
  status            UserStatus         @default(active)
  failedLoginCount  Int                @default(0) @map("failed_login_count")
  lockedUntil       DateTime?          @map("locked_until")
  passwordChangedAt DateTime           @default(now()) @map("password_changed_at")
  lastLoginAt       DateTime?          @map("last_login_at")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")
  store             Store              @relation(fields: [storeId], references: [id])
  sessions          Session[]
  resetOtps         PasswordResetOtp[]
  auditLogs         AuditLog[]
  stockMovements    StockMovement[]
  idempotencyKeys   IdempotencyKey[]
  supplierEntries   SupplierLedgerEntry[]
  supplierPayments  SupplierPayment[]
  purchaseOrders    PurchaseOrder[]
  purchaseEvents    PurchaseOrderEvent[]
  receivingSessions ReceivingSession[]
  goodsReceipts     GoodsReceipt[]
  customers         Customer[]
  pointLogs         PointLog[]
  promotions        Promotion[]

  @@index([storeId])
  @@map("users")
}

model Session {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  familyId     String    @map("family_id") @db.Uuid
  tokenHash    String    @unique @map("token_hash")
  userAgent    String?   @map("user_agent")
  ip           String?
  remember     Boolean   @default(false)
  expiresAt    DateTime  @map("expires_at")
  revokedAt    DateTime? @map("revoked_at")
  replacedById String?   @map("replaced_by_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at")
  lastUsedAt   DateTime  @default(now()) @map("last_used_at")
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([familyId])
  @@map("sessions")
}

model PasswordResetOtp {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  codeHash  String    @map("code_hash")
  attempts  Int       @default(0)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt])
  @@map("password_reset_otps")
}

model AuditLog {
  id        String      @id @default(uuid()) @db.Uuid
  userId    String?     @map("user_id") @db.Uuid
  action    AuditAction
  ip        String?
  userAgent String?     @map("user_agent")
  meta      Json?
  createdAt DateTime    @default(now()) @map("created_at")
  user      User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}

model Category {
  id          String         @id @default(uuid()) @db.Uuid
  name        String         @db.VarChar(50)
  nameKey     String         @unique @map("name_key")
  description String?        @db.VarChar(255)
  icon        String         @default("package")
  color       String         @default("slate")
  status      CategoryStatus @default(active)
  sortOrder   Int            @map("sort_order")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")
  products    Product[]
  suppliers   SupplierCategory[]
  promotions  PromotionCategory[]

  @@index([sortOrder])
  @@map("categories")
}

model Unit {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @db.VarChar(20)
  nameKey     String    @unique @map("name_key")
  description String?   @db.VarChar(255)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  products    Product[]

  @@map("units")
}

model Product {
  id            String          @id @default(uuid()) @db.Uuid
  sku           String          @db.VarChar(32)
  skuKey        String?         @unique @map("sku_key") @db.VarChar(32)
  barcode       String?         @db.VarChar(14)
  barcodeKey    String?         @unique @map("barcode_key") @db.VarChar(14)
  name          String          @db.VarChar(150)
  searchKey     String          @map("search_key")
  categoryId    String?         @map("category_id") @db.Uuid
  unitId        String?         @map("unit_id") @db.Uuid
  price         Int
  originalPrice Int?            @map("original_price")
  costPrice     Int?            @map("cost_price")
  minStock      Int             @default(10) @map("min_stock")
  image         String?         @db.VarChar(500)
  imageFit      ImageFit        @default(auto) @map("image_fit")
  isBestSeller  Boolean         @default(false) @map("is_best_seller")
  status        ProductStatus   @default(active)
  description   String?         @db.VarChar(1000)
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")
  deletedAt     DateTime?       @map("deleted_at")
  category      Category?       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  unit          Unit?           @relation(fields: [unitId], references: [id], onDelete: Restrict)
  stocks        ProductStock[]
  movements     StockMovement[]
  purchaseItems PurchaseOrderItem[]
  receiptLines  GoodsReceiptLine[]
  promotions    PromotionProduct[]

  @@index([categoryId])
  @@index([unitId])
  @@index([status, deletedAt])
  @@index([createdAt])
  @@map("products")
}

model ProductStock {
  productId      String    @map("product_id") @db.Uuid
  storeId        String    @map("store_id") @db.Uuid
  quantity       Int       @default(0)
  lastMovementAt DateTime? @map("last_movement_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  product        Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  store          Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@id([productId, storeId])
  @@index([storeId, quantity])
  @@map("product_stocks")
}

model StockMovement {
  id          String       @id @default(uuid()) @db.Uuid
  productId   String       @map("product_id") @db.Uuid
  storeId     String       @map("store_id") @db.Uuid
  type        MovementType
  quantity    Int
  before      Int
  after       Int
  reason      String?      @db.VarChar(255)
  note        String?      @db.VarChar(500)
  refCode     String?      @map("ref_code") @db.VarChar(50)
  createdById String       @map("created_by_id") @db.Uuid
  createdAt   DateTime     @default(now()) @map("created_at")
  product     Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  store       Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  createdBy   User         @relation(fields: [createdById], references: [id])

  @@index([storeId, createdAt(sort: Desc)])
  @@index([storeId, productId, createdAt(sort: Desc)])
  @@index([storeId, type, createdAt])
  @@index([productId])
  @@map("stock_movements")
}

model IdempotencyKey {
  userId     String   @map("user_id") @db.Uuid
  key        String   @db.VarChar(100)
  scope      String   @db.VarChar(50)
  resourceId String   @map("resource_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, key])
  @@index([createdAt])
  @@map("idempotency_keys")
}

model Supplier {
  id              String                @id @default(uuid()) @db.Uuid
  code            String                @unique @db.VarChar(20)
  name            String                @db.VarChar(150)
  nameKey         String                @unique @map("name_key")
  contact         String                @db.VarChar(100)
  phone           String                @unique @db.VarChar(10)
  email           String?               @db.VarChar(150)
  address         String                @db.VarChar(255)
  taxCode         String?               @unique @map("tax_code") @db.VarChar(13)
  paymentTermDays Int                   @default(15) @map("payment_term_days")
  bankName        String?               @map("bank_name") @db.VarChar(100)
  bankAccount     String?               @map("bank_account") @db.VarChar(19)
  bankHolder      String?               @map("bank_holder") @db.VarChar(100)
  note            String?               @db.VarChar(500)
  status          SupplierStatus        @default(active)
  suspendReason   String?               @map("suspend_reason") @db.VarChar(120)
  suspendedUntil  DateTime?             @map("suspended_until")
  debt            BigInt                @default(0)
  searchKey       String                @map("search_key")
  createdAt       DateTime              @default(now()) @map("created_at")
  updatedAt       DateTime              @updatedAt @map("updated_at")
  categories      SupplierCategory[]
  ledger          SupplierLedgerEntry[]
  payments        SupplierPayment[]
  purchaseOrders  PurchaseOrder[]
  goodsReceipts   GoodsReceipt[]

  @@index([status])
  @@index([createdAt])
  @@map("suppliers")
}

model SupplierCategory {
  supplierId String   @map("supplier_id") @db.Uuid
  categoryId String   @map("category_id") @db.Uuid
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([supplierId, categoryId])
  @@index([categoryId])
  @@map("supplier_categories")
}

model SupplierLedgerEntry {
  id           String             @id @default(uuid()) @db.Uuid
  supplierId   String             @map("supplier_id") @db.Uuid
  kind         SupplierLedgerKind
  amount       BigInt
  balanceAfter BigInt             @map("balance_after")
  code         String             @db.VarChar(30)
  label        String             @db.VarChar(200)
  refType      String?            @map("ref_type") @db.VarChar(30)
  refId        String?            @map("ref_id") @db.Uuid
  occurredAt   DateTime           @default(now()) @map("occurred_at")
  dueAt        DateTime?          @map("due_at")
  createdById  String             @map("created_by_id") @db.Uuid
  supplier     Supplier           @relation(fields: [supplierId], references: [id])
  createdBy    User               @relation(fields: [createdById], references: [id])

  @@index([supplierId, occurredAt])
  @@index([kind, occurredAt])
  @@map("supplier_ledger_entries")
}

model SupplierPayment {
  id         String        @id @default(uuid()) @db.Uuid
  code       String        @unique @db.VarChar(30)
  supplierId String        @map("supplier_id") @db.Uuid
  amount     BigInt
  method     PaymentMethod
  reference  String?       @db.VarChar(60)
  note       String?       @db.VarChar(255)
  paidAt     DateTime      @default(now()) @map("paid_at")
  paidById   String        @map("paid_by_id") @db.Uuid
  supplier   Supplier      @relation(fields: [supplierId], references: [id])
  paidBy     User          @relation(fields: [paidById], references: [id])

  @@index([supplierId, paidAt])
  @@map("supplier_payments")
}

model PurchaseOrder {
  id           String              @id @default(uuid()) @db.Uuid
  code         String              @unique @db.VarChar(20)
  storeId      String              @map("store_id") @db.Uuid
  supplierId   String              @map("supplier_id") @db.Uuid
  status       PurchaseOrderStatus @default(draft)
  discount     Int                 @default(0)
  note         String?             @db.VarChar(500)
  expectedDate DateTime            @map("expected_date") @db.Date
  placedAt     DateTime?           @map("placed_at")
  completedAt  DateTime?           @map("completed_at")
  cancelReason String?             @map("cancel_reason") @db.VarChar(200)
  cancelledAt  DateTime?           @map("cancelled_at")
  createdById  String              @map("created_by_id") @db.Uuid
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")
  store        Store               @relation(fields: [storeId], references: [id])
  supplier     Supplier            @relation(fields: [supplierId], references: [id])
  createdBy    User                @relation(fields: [createdById], references: [id])
  items        PurchaseOrderItem[]
  events       PurchaseOrderEvent[]
  receipts     GoodsReceipt[]
  session      ReceivingSession?

  @@index([storeId, status])
  @@index([storeId, createdAt])
  @@index([supplierId, createdAt])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id          String        @id @default(uuid()) @db.Uuid
  poId        String        @map("po_id") @db.Uuid
  productId   String        @map("product_id") @db.Uuid
  lineNo      Int           @map("line_no")
  orderedQty  Int           @map("ordered_qty")
  unitCost    Int           @map("unit_cost")
  packSize    Int           @default(1) @map("pack_size")
  receivedQty Int           @default(0) @map("received_qty")
  damagedQty  Int           @default(0) @map("damaged_qty")
  po          PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
  product     Product       @relation(fields: [productId], references: [id])

  @@unique([poId, productId])
  @@index([productId])
  @@map("purchase_order_items")
}

model PurchaseOrderEvent {
  id    String        @id @default(uuid()) @db.Uuid
  poId  String        @map("po_id") @db.Uuid
  label String        @db.VarChar(200)
  at    DateTime      @default(now())
  byId  String        @map("by_id") @db.Uuid
  po    PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
  by    User          @relation(fields: [byId], references: [id])

  @@index([poId, at])
  @@map("purchase_order_events")
}

model ReceivingSession {
  poId        String        @id @map("po_id") @db.Uuid
  data        Json
  startedById String        @map("started_by_id") @db.Uuid
  startedAt   DateTime      @default(now()) @map("started_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  version     Int           @default(1)
  po          PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
  startedBy   User          @relation(fields: [startedById], references: [id])

  @@map("receiving_sessions")
}

model GoodsReceipt {
  id            String             @id @default(uuid()) @db.Uuid
  code          String             @unique @db.VarChar(20)
  poId          String             @map("po_id") @db.Uuid
  storeId       String             @map("store_id") @db.Uuid
  supplierId    String             @map("supplier_id") @db.Uuid
  supplierDocNo String             @map("supplier_doc_no") @db.VarChar(50)
  packageCount  Int                @default(0) @map("package_count")
  packagingOk   Boolean            @default(true) @map("packaging_ok")
  deliveredBy   String?            @map("delivered_by") @db.VarChar(100)
  note          String?            @db.VarChar(500)
  approvedBy    String?            @map("approved_by") @db.VarChar(100)
  grossValue    Int                @map("gross_value")
  discount      Int                @default(0)
  value         Int
  receivedById  String             @map("received_by_id") @db.Uuid
  receivedAt    DateTime           @default(now()) @map("received_at")
  po            PurchaseOrder      @relation(fields: [poId], references: [id])
  store         Store              @relation(fields: [storeId], references: [id])
  supplier      Supplier           @relation(fields: [supplierId], references: [id])
  receivedBy    User               @relation(fields: [receivedById], references: [id])
  lines         GoodsReceiptLine[]

  @@index([poId])
  @@index([supplierId, receivedAt])
  @@index([storeId, receivedAt])
  @@map("goods_receipts")
}

model GoodsReceiptLine {
  id          String       @id @default(uuid()) @db.Uuid
  receiptId   String       @map("receipt_id") @db.Uuid
  productId   String       @map("product_id") @db.Uuid
  lineNo      Int          @map("line_no")
  expectedQty Int          @map("expected_qty")
  scannedQty  Int          @map("scanned_qty")
  acceptedQty Int          @map("accepted_qty")
  damagedQty  Int          @map("damaged_qty")
  returnedQty Int          @default(0) @map("returned_qty")
  unitCost    Int          @map("unit_cost")
  extra       Boolean      @default(false)
  expiryDate  DateTime?    @map("expiry_date") @db.Date
  lotNo       String?      @map("lot_no") @db.VarChar(40)
  receipt     GoodsReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  product     Product      @relation(fields: [productId], references: [id])

  @@index([receiptId])
  @@index([productId])
  @@map("goods_receipt_lines")
}

enum CustomerTier {
  retail
  silver
  gold
  diamond
}

enum CustomerStatus {
  active
  blocked
}

enum Gender {
  male
  female
  other
}

enum PointLogType {
  opening
  earn
  revoke
  adjust
  redeem
}

model Customer {
  id           String         @id @default(uuid()) @db.Uuid
  code         String         @unique @db.VarChar(12)
  name         String         @db.VarChar(100)
  phone        String         @unique @db.VarChar(10)
  email        String?        @db.VarChar(150)
  gender       Gender?
  birthday     DateTime?      @db.Date
  address      String?        @db.VarChar(255)
  note         String?        @db.VarChar(500)
  status       CustomerStatus @default(active)
  tier         CustomerTier   @default(retail)
  points       Int            @default(0)
  legacySpent  BigInt         @default(0) @map("legacy_spent")
  spent        BigInt         @default(0)
  orderCount   Int            @default(0) @map("order_count")
  firstOrderAt DateTime?      @map("first_order_at")
  lastOrderAt  DateTime?      @map("last_order_at")
  searchKey    String         @map("search_key")
  givenNameKey String         @map("given_name_key")
  createdById  String?        @map("created_by_id") @db.Uuid
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")
  createdBy    User?          @relation(fields: [createdById], references: [id], onDelete: SetNull)
  pointLogs    PointLog[]
  redemptions  PromotionRedemption[]

  @@index([tier])
  @@index([status])
  @@index([lastOrderAt])
  @@index([createdAt])
  @@map("customers")
}

model PointLog {
  id          String       @id @default(uuid()) @db.Uuid
  customerId  String       @map("customer_id") @db.Uuid
  type        PointLogType
  points      Int
  balance     Int
  refCode     String?      @map("ref_code") @db.VarChar(30)
  reason      String?      @db.VarChar(120)
  createdById String       @map("created_by_id") @db.Uuid
  createdAt   DateTime     @default(now()) @map("created_at")
  customer    Customer     @relation(fields: [customerId], references: [id])
  createdBy   User         @relation(fields: [createdById], references: [id])

  @@index([customerId, createdAt])
  @@map("point_logs")
}

model MembershipSettings {
  id             Int      @id @default(1)
  amountPerPoint Int      @default(10000) @map("amount_per_point")
  pointValue     Int      @default(100) @map("point_value")
  updatedById    String?  @map("updated_by_id") @db.Uuid
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("membership_settings")
}

model MembershipTier {
  tier            CustomerTier @id
  label           String       @db.VarChar(30)
  minSpent        BigInt       @map("min_spent")
  discountPercent Decimal      @map("discount_percent") @db.Decimal(5, 2)
  pointMultiplier Decimal      @map("point_multiplier") @db.Decimal(4, 2)
  perks           String       @db.VarChar(200)
  sortOrder       Int          @map("sort_order")

  @@map("membership_tiers")
}

enum PromotionKind {
  voucher
  product
  order
  gift
}

enum DiscountType {
  percent
  amount
}

enum PromotionState {
  draft
  active
  paused
  ended
}

enum ScopeType {
  all
  categories
  products
}

model Promotion {
  id               String                @id @default(uuid()) @db.Uuid
  code             String                @unique @db.VarChar(20)
  name             String                @db.VarChar(120)
  description      String?               @db.VarChar(500)
  searchKey        String                @map("search_key")
  kind             PromotionKind
  discountType     DiscountType          @map("discount_type")
  discountValue    Int                   @map("discount_value")
  maxDiscount      Int?                  @map("max_discount")
  minOrder         Int?                  @map("min_order")
  scopeType        ScopeType             @default(all) @map("scope_type")
  usageLimit       Int?                  @map("usage_limit")
  perCustomerLimit Int?                  @map("per_customer_limit")
  stackable        Boolean               @default(true)
  state            PromotionState        @default(draft)
  startAt          DateTime              @map("start_at")
  endAt            DateTime?             @map("end_at")
  usedCount        Int                   @default(0) @map("used_count")
  createdById      String                @map("created_by_id") @db.Uuid
  createdAt        DateTime              @default(now()) @map("created_at")
  updatedAt        DateTime              @updatedAt @map("updated_at")
  createdBy        User                  @relation(fields: [createdById], references: [id])
  categories       PromotionCategory[]
  products         PromotionProduct[]
  redemptions      PromotionRedemption[]

  @@index([kind, state])
  @@index([createdAt])
  @@map("promotions")
}

model PromotionCategory {
  promotionId String    @map("promotion_id") @db.Uuid
  categoryId  String    @map("category_id") @db.Uuid
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  category    Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([promotionId, categoryId])
  @@index([categoryId])
  @@map("promotion_categories")
}

model PromotionProduct {
  promotionId String    @map("promotion_id") @db.Uuid
  productId   String    @map("product_id") @db.Uuid
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([promotionId, productId])
  @@index([productId])
  @@map("promotion_products")
}

model PromotionRedemption {
  id          String    @id @default(uuid()) @db.Uuid
  promotionId String    @map("promotion_id") @db.Uuid
  orderId     String    @unique @map("order_id") @db.Uuid
  orderCode   String    @map("order_code") @db.VarChar(30)
  customerId  String?   @map("customer_id") @db.Uuid
  discount    Int
  revenue     Int
  revokedAt   DateTime? @map("revoked_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  promotion   Promotion @relation(fields: [promotionId], references: [id])
  customer    Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([promotionId, createdAt])
  @@index([promotionId, customerId])
  @@map("promotion_redemptions")
}
